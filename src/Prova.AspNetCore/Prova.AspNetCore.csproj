<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(ToolkitLibraryTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Prova.AspNetCore</RootNamespace>
    <IsPackable>true</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- Shipping library, not a test app. dotnet test keys off IsTestingPlatformApplication;
         without this, these libraries were picked up as runnable test projects and the whole
         solution-level dotnet test aborted with "Ensure you have a runnable project type". -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <EnableMicrosoftTestingPlatform>false</EnableMicrosoftTestingPlatform>

    <PackageId>Prova.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for the Prova testing framework.</Description>
    <Authors>Digvijay</Authors>
    <Company>Prova</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Digvijay/Prova</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Digvijay/Prova.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>test testing aot mtp aspnetcore</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Was pinned to 10.0.0-preview.1.25120.3: a shipping library depending on an abandoned
         preview build, which also pinned the whole package to net10.0. Use the stable release
         matching each target framework instead. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.31" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" Condition="'$(TargetFramework)' != 'net8.0'" />
    <ProjectReference Include="..\Prova.Core\Prova.Core.csproj" />
  </ItemGroup>

</Project>
