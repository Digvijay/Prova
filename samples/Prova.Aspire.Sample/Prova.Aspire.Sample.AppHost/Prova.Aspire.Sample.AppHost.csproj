<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Aspire app hosts require the Aspire.AppHost.Sdk in addition to Microsoft.NET.Sdk. Without it
    the Projects.* metadata type that the test project resolves is never generated.
  -->
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.4" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <!--
      The sample does not use any feature that needs the Aspire CLI bundle, and downloading it
      would make an offline or air-gapped build fail (ASPIRE010).
    -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.6.0" />
    <!-- ServiceDefaults is a shared library, not a resource the host launches (ASPIRE004). -->
    <ProjectReference Include="..\Prova.Aspire.Sample.ServiceDefaults\Prova.Aspire.Sample.ServiceDefaults.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>