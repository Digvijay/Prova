<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Prova.Core\Prova.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Was a hardcoded <Analyzer Include="...\bin\Debug\netstandard2.0\Prova.Generators.dll" />,
         which only resolved after a Debug build and broke every Release build. A ProjectReference
         with OutputItemType="Analyzer" lets MSBuild resolve the generator for any configuration. -->
    <ProjectReference Include="..\..\src\Prova.Generators\Prova.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
