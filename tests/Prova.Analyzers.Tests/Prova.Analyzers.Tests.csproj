<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Runs on the Microsoft.Testing.Platform runner, like every other test project here.
         This project was previously absent from Prova.sln, so it was never built or run. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.4.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <!-- The framework-specific *.Testing.MSTest verifier packages are deprecated and bind to
         MSTest 3's Microsoft.VisualStudio.TestPlatform.TestFramework assembly, which MSTest 4
         no longer ships. Use the framework-agnostic packages with DefaultVerifier instead. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Prova.Analyzers\Prova.Analyzers.csproj" />
  </ItemGroup>

</Project>
